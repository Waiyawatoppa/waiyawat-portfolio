# Supabase — public values, safe to expose (they ship in the client bundle).
# RLS must deny INSERT/UPDATE/DELETE to the `anon` role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses RLS — SERVER ONLY.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth credentials for NextAuth.
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Required by NextAuth v5 in production. Generate with: npx auth secret
AUTH_SECRET=your-auth-secret

# The single Google account allowed to sign in and mutate content.
ADMIN_EMAIL=you@example.com

# Canonical site origin, used for metadata, OG images, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
